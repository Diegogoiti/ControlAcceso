<Window x:Class="ControlAcceso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Acceso" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BOTÓN PRINCIPAL SUPERIOR -->
        <Button x:Name="btnMarcarEntrada"
                Grid.Row="0"
                Content="MARCAR ENTRADA"
                Click="btnMarcarEntrada_Click"
                Style="{StaticResource PrimaryButton}"
                Height="80"
                FontSize="24"/>

        <!-- PANEL CENTRAL: RELOJ O MENSAJE SENSOR -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- CONTENEDOR DEL RELOJ -->
            <StackPanel x:Name="panelReloj"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Visible">
                <TextBlock x:Name="lblHora"
                           Text="00:00:00"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="lblFecha"
                           Text="Cargando fecha..."
                           FontSize="20"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- CONTENEDOR DEL CAPTAHUELLAS (MENSAJE DINÁMICO) -->
            <StackPanel x:Name="panelCaptahuellas"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">

                <TextBlock x:Name="lblMensajeSensor"
                           Text=""
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Button x:Name="btnCancelarCaptura"
                        Content="Cancelar Marcaje"
                        Click="btnCancelarCaptura_Click"
                        Style="{StaticResource DangerButton}"
                        BorderThickness="0"
                        Margin="0,25,0,0"
                        Padding="20,10"
                        FontSize="16"/>
            </StackPanel>

            <StackPanel x:Name="PanelExito" Visibility="Collapsed">
                <TextBlock x:Name="TxtNombreEmpleado"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#166534"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtHoraEntrada"
                           FontSize="24"
                           Foreground="#475569"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 3. PANEL DE FALLO (Se activa si la huella no se reconoce) -->
            <StackPanel x:Name="PanelFallo" Visibility="Collapsed">
                <TextBlock Text="Huella no reconocida"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#DC2626"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtMensajeError"
                           Text="Intenta de nuevo o llama a tu supervisor"
                           FontSize="24"
                           Foreground="#475569"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 4. PANEL DE ACCESO DENEGADO (Se activa por hora límite) -->
            <StackPanel x:Name="PanelDenegado" Visibility="Collapsed" MaxWidth="700">
                <TextBlock Text="ACCESO DENEGADO"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#DC2626"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtMensajeDenegado"
                           Text="Mensaje de acceso denegado"
                           FontSize="24"
                           Foreground="#475569"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">
            <!-- ACCESO A REPORTES -->
            <Button x:Name="btnReportes"
                    Content="📊 Reportes"
                    Click="btnReportes_Click"
                    Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left"/>

            <!-- ACCESO A ADMINISTRACIÓN -->
            <Button x:Name="btnAdministrar"
                    Content="⚙️ Panel de Administración"
                    Click="btnAdministrar_Click"
                    Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
