<Window x:Class="ControlAcceso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Acceso" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BOTÓN PRINCIPAL SUPERIOR -->
        <Button x:Name="btnMarcarEntrada"
                Grid.Row="0"
                Content="MARCAR ENTRADA"
                Click="btnMarcarEntrada_Click"
                Height="80"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                Background="#2563EB"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- PANEL CENTRAL: RELOJ O MENSAJE SENSOR -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- CONTENEDOR DEL RELOJ -->
            <StackPanel x:Name="panelReloj"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Visible">
                <TextBlock x:Name="lblHora"
                           Text="00:00:00"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="lblFecha"
                           Text="Cargando fecha..."
                           FontSize="20"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- CONTENEDOR DEL CAPTAHUELLAS (MENSAJE DINÁMICO) -->
            <StackPanel x:Name="panelCaptahuellas"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">

                <TextBlock x:Name="lblMensajeSensor"
                           Text=""
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Button x:Name="btnCancelarCaptura"
                        Content="Cancelar Marcaje"
                        Click="btnCancelarCaptura_Click"
                        Margin="0,25,0,0"
                        Padding="20,10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#DC2626"
                        Background="#FEE2E2"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </Grid>

        <!-- ACCESO A ADMINISTRACIÓN -->
        <Button x:Name="btnAdministrar"
                Grid.Row="2"
                Content="⚙️ Panel de Administración"
                Click="btnAdministrar_Click"
                HorizontalAlignment="Right"
                Padding="16,8"
                FontSize="14"
                Foreground="#475569"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>
