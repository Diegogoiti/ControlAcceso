<Window x:Class="ControlAcceso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Acceso" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!-- Botón de Marcar Entrada arriba -->
            <RowDefinition Height="Auto"/>
            <!-- Hora centrada en medio -->
            <RowDefinition Height="*"/>
            <!-- Botón opcional de Administración abajo -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BOTÓN PRINCIPAL SUPERIOR -->
        <Button x:Name="btnMarcarEntrada"
                Grid.Row="0"
                Content="MARCAR ENTRADA"
                Click="btnMarcarEntrada_Click"
                Height="80"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                Background="#2563EB"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- RELOJ CENTRADO EN MEDIO -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock x:Name="lblHora"
                       Text="00:00:00"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="lblFecha"
                       Text="Cargando fecha..."
                       FontSize="20"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- ACCESO A ADMINISTRACIÓN -->
        <Button x:Name="btnAdministrar"
                Grid.Row="2"
                Content="⚙️ Panel de Administración"
                Click="btnAdministrar_Click"
                HorizontalAlignment="Right"
                Padding="16,8"
                FontSize="14"
                Foreground="#475569"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>
