<Window x:Class="ControlAcceso.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">

    <Grid>
        <Border Style="{StaticResource ModalContentSmall}">
            <StackPanel VerticalAlignment="Center">

                <Border Style="{StaticResource HeaderIcon}">
                    <TextBlock Text="🔑" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Cambiar contraseña" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="Define la nueva contraseña de administrador del sistema." FontSize="13" Foreground="#64748B" Margin="0,0,0,24" TextAlignment="Center" TextWrapping="Wrap"/>

                <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdNueva" Style="{StaticResource ModernPasswordBox}"/>

                <TextBlock Text="Confirmar nueva contraseña" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdConfirmar" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnGuardar" Content="Guardar" Width="150" Height="44" Style="{StaticResource PrimaryButton}" Click="btnGuardar_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnCancelar" Content="Cancelar" Width="120" Height="44" Style="{StaticResource SecondaryButton}" Click="btnCancelar_Click"/>
                </StackPanel>

                <TextBlock x:Name="txtEstado" Text="" FontSize="12" Foreground="#64748B" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
