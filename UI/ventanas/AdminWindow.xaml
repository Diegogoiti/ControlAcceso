<Window x:Class="ControlAcceso.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Administración" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Estilo base para los campos de texto -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
        </Style>

        <!-- Etiquetas -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- Botones de Pestaña -->
        <Style x:Key="TabNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Navegación Superior -->
            <RowDefinition Height="*"/>    <!-- Contenido Principal -->
        </Grid.RowDefinitions>

        <!-- 1. BARRA NAVEGACIÓN SUPERIOR -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabRegistrar" Content="📝 Registrar Empleado" Style="{StaticResource TabNavButton}" Foreground="#2563EB" Click="btnTabRegistrar_Click"/>
                <Button x:Name="btnTabEmpleados" Content="👥 Lista de Empleados" Style="{StaticResource TabNavButton}" Click="btnTabEmpleados_Click"/>
                <Button x:Name="btnTabConfig" Content="⚙️ Configuración" Style="{StaticResource TabNavButton}" Click="btnTabConfig_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. CONTENIDO DINÁMICO -->
        <Grid Grid.Row="1">

            <!-- VISTA 1: REGISTRAR EMPLEADO -->
            <Border x:Name="PanelRegistrar" Visibility="Visible" Background="White" CornerRadius="12" Padding="24" MaxWidth="650" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Registrar Nuevo Empleado" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                        <TextBlock Text="Cédula / Identificación" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCedula" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Nombre Completo" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNombre" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Cargo / Rol" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCargo" Style="{StaticResource ModernTextBox}"/>

                        <!-- Captura Biométrica -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,5,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Biometría" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Button x:Name="btnCapturarHuella" Content="👆 Capturar Huella Digital" Padding="16,10" Background="#E2E8F0" Foreground="#1E293B" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardarEmpleado" Content="Guardar Empleado" Height="45" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- VISTA 2: LISTA DE EMPLEADOS -->
            <Border x:Name="PanelEmpleados" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filtros -->
                        <RowDefinition Height="*"/>    <!-- Tabla -->
                        <RowDefinition Height="Auto"/> <!-- Botones -->
                    </Grid.RowDefinitions>

                    <!-- Filtros con Grid adaptativo -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Buscar:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtBuscarNombre" Style="{StaticResource ModernTextBox}" Margin="0,0,20,0" TextChanged="txtBuscarNombre_TextChanged"/>

                        <TextBlock Grid.Column="2" Text="Estado:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="3" x:Name="cmbFiltroEstado" Width="140" Style="{StaticResource ModernComboBox}" Margin="0" SelectedIndex="0" SelectionChanged="cmbFiltroEstado_SelectionChanged">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Activos"/>
                            <ComboBoxItem Content="Inactivos"/>
                        </ComboBox>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="dgEmpleados" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="140"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="180"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoStr}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="btnEditarEmpleado" Content="✏️ Editar" Padding="16,8" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="btnCambiarEstado" Content="🚫 Cambiar Estado" Padding="16,8" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VISTA 3: CONFIGURACIÓN -->
            <Border x:Name="PanelConfiguracion" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="24" MaxWidth="650" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Configuración del Sistema" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                    <TextBlock Text="Servidor Base de Datos" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtServerBD" Text="localhost" Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Lector Biométrico Seleccionado" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbLectores" Style="{StaticResource ModernComboBox}"/>

                    <Button x:Name="btnGuardarConfig" Content="Guardar Configuración" Height="45" Margin="0,10,0,0" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
