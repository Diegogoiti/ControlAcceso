<Window x:Class="ControlAcceso.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Administración" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Estilo base para los campos de texto -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
        </Style>

        <!-- Etiquetas -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- Botones de Pestaña (barra superior) -->
        <Style x:Key="TabNavButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de acción (barra sobre la lista de empleados) -->
        <Style x:Key="ActionPillButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones secundarios de Huella -->
        <Style x:Key="FingerprintButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#DBEAFE"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#BFDBFE"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Navegación Superior -->
                <RowDefinition Height="*"/>    <!-- Contenido Principal -->
            </Grid.RowDefinitions>

            <!-- 1. BARRA NAVEGACIÓN SUPERIOR -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnTabEmpleados" Content="👥 Lista de Empleados" Style="{StaticResource TabNavButton}" Click="btnTabEmpleados_Click"/>
                    <Button x:Name="btnTabConfig" Content="⚙️ Configuración" Style="{StaticResource TabNavButton}" Click="btnTabConfig_Click"/>
                </StackPanel>
            </Border>

            <!-- 2. CONTENIDO DINÁMICO -->
            <Grid Grid.Row="1">

                <!-- VISTA 1: LISTA DE EMPLEADOS -->
                <Border x:Name="PanelEmpleados" Visibility="Visible" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros adaptativos -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Buscar:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="txtBuscarNombre" Style="{StaticResource ModernTextBox}" Margin="0,0,20,0" TextChanged="txtBuscarNombre_TextChanged"/>

                            <TextBlock Grid.Column="2" Text="Estado:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="3" x:Name="cmbFiltroEstado" Width="140" Style="{StaticResource ModernComboBox}" Margin="0" SelectedIndex="0" SelectionChanged="cmbFiltroEstado_SelectionChanged">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Activo"/>
                                <ComboBoxItem Content="Inactivo"/>
                            </ComboBox>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  x:Name="dgEmpleados"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#94A3B8"
                                  VerticalGridLinesBrush="#CBD5E1"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  RowBackground="#FFFFFF"
                                  AlternatingRowBackground="#E2E8F0"
                                  BorderBrush="#64748B"
                                  BorderThickness="1"
                                  RowHeight="38"
                                  HorizontalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1E40AF"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Nombre Completo" Binding="{Binding Nombre}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Tel. Emergencia" Binding="{Binding TelefonoEmergencia}" Width="Auto" MinWidth="130"/>
                                <DataGridTextColumn Header="F. Nacimiento" Binding="{Binding FechaNacimiento, StringFormat=dd/MM/yyyy}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="Auto" MinWidth="200"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding NombreRol}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="F. Ingreso" Binding="{Binding FechaIngreso, StringFormat=dd/MM/yyyy}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" MinWidth="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button x:Name="btnRegistrarAsistencia" Content="🕒 Registrar Asistencia" Style="{StaticResource ActionPillButton}" Background="#E0F2FE" Foreground="#0C4A6E" BorderBrush="#7DD3FC" Click="btnRegistrarAsistencia_Click"/>
                            <Button x:Name="btnNuevoEmpleado" Content="➕ Nuevo Empleado" Style="{StaticResource ActionPillButton}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" Click="btnNuevoEmpleado_Click"/>
                            <Button x:Name="btnEditarEmpleado" Content="✏️ Editar" Style="{StaticResource ActionPillButton}" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" Click="btnEditarEmpleado_Click"/>
                            <Button x:Name="btnCambiarEstado" Content="🚫 Cambiar Estado" Style="{StaticResource ActionPillButton}" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" Margin="0" Click="btnCambiarEstado_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VISTA 2: CONFIGURACIÓN -->
                <Border x:Name="PanelConfiguracion" Visibility="Collapsed" Background="White" CornerRadius="16" Padding="24" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Border Background="#F8FAFC" CornerRadius="18" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Width="620">
                            <TextBlock Text="⚙️ Configuración del sistema" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ajusta la contraseña, los horarios de acceso y las huellas del administrador." FontSize="13" Foreground="#64748B" Margin="0,0,0,18" TextAlignment="Center"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Acceso administrativo" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <TextBlock Text="Hora de entrada" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ComboBox x:Name="cmbHoraEntrada" Width="90" Height="40" Margin="0,0,8,0" SelectedIndex="8"/>
                                        <ComboBox x:Name="cmbMinutoEntrada" Width="90" Height="40" SelectedIndex="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <TextBlock Text="Hora límite de ingreso" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ComboBox x:Name="cmbHoraLimite" Width="90" Height="40" Margin="0,0,8,0" SelectedIndex="8"/>
                                        <ComboBox x:Name="cmbMinutoLimite" Width="90" Height="40" SelectedIndex="30"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12" HorizontalAlignment="Center" Width="320">
                                    <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <PasswordBox x:Name="pwdAdminPassword" Height="40" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6" HorizontalAlignment="Center">
                                    <TextBlock Text="Huellas de administrador (3)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <Button x:Name="btnAdminHuella1" Content="📷 Huella 1" Width="110" Height="40" Margin="0,0,10,10" Background="#F8FAFC" Foreground="#334155" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Tag="1" Click="btnCapturarAdminHuella_Click"/>
                                        <Button x:Name="btnAdminHuella2" Content="📷 Huella 2" Width="110" Height="40" Margin="0,0,10,10" Background="#F8FAFC" Foreground="#334155" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Tag="2" Click="btnCapturarAdminHuella_Click"/>
                                        <Button x:Name="btnAdminHuella3" Content="📷 Huella 3" Width="110" Height="40" Margin="0,0,10,10" Background="#F8FAFC" Foreground="#334155" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Tag="3" Click="btnCapturarAdminHuella_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="btnGuardarConfig" Content="Guardar configuración" Height="46" Margin="0,16,0,0" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarConfig_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>
        </Grid>

        <!-- OVERLAY MODAL: REGISTRAR NUEVO EMPLEADO -->
        <Grid x:Name="OverlayRegistrarEmpleado" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="880" MaxHeight="750" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📝 Registrar Nuevo Empleado" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna Izquierda -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cédula / Identificación" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCedula" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Nombre Completo" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNombreCompleto" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Fecha de Nacimiento" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="dpFechaNacimiento" Style="{StaticResource ModernDatePicker}"/>

                                <TextBlock Text="Rol / Permiso" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbRol" Style="{StaticResource ModernComboBox}"
          DisplayMemberPath="Nombre" SelectedValuePath="Id" />

                            </StackPanel>

                            <!-- Columna Derecha -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono Principal" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Teléfono de Emergencia" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTelefonoEmergencia" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Dirección de Habitación" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDireccion" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- SECCIÓN MULTI-HUELLA BIOMÉTRICA -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,10,0,15">
                            <StackPanel>
                                <TextBlock Text="Registro Biométrico" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="btnHuella1" Content="👍 Dedo 1 (No registrado)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedo_Click" Tag="1"/>
                                    <Button x:Name="btnHuella2" Content="👍 Dedo 2 (No registrado)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedo_Click" Tag="2"/>
                                    <Button x:Name="btnHuella3" Content="👍 Dedo 3 (No registrado)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedo_Click" Tag="3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancelar" Height="40" Background="#94A3B8" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancelarRegistro_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" x:Name="btnGuardarEmpleado" Content="Guardar Empleado" Height="40" Background="#16A34A" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarEmpleado_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- OVERLAY MODAL: MODIFICAR / EDITAR EMPLEADO -->
        <Grid x:Name="OverlayEditarEmpleado" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="880" MaxHeight="750" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="✏️ Modificar Datos del Empleado" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna Izquierda -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cédula / Identificación" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEditCedula" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Nombre Completo" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEditNombreCompleto" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Fecha de Nacimiento" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="dpEditFechaNacimiento" Style="{StaticResource ModernDatePicker}"/>

                                <TextBlock Text="Rol / Permiso" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbEditRol" Style="{StaticResource ModernComboBox}"
          DisplayMemberPath="Nombre" SelectedValuePath="Id" />
                            </StackPanel>

                            <!-- Columna Derecha -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono Principal" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEditTelefono" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Teléfono de Emergencia" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEditTelefonoEmergencia" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Text="Dirección de Habitación" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEditDireccion" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- SECCIÓN MULTI-HUELLA BIOMÉTRICA (EDICIÓN) -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="16" Margin="0,10,0,15">
                            <StackPanel>
                                <TextBlock Text="Actualizar Registro Biométrico" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="btnEditHuella1" Content="👍 Dedo 1 (Sin cambios)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedoEdicion_Click" Tag="1"/>
                                    <Button x:Name="btnEditHuella2" Content="👍 Dedo 2 (Sin cambios)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedoEdicion_Click" Tag="2"/>
                                    <Button x:Name="btnEditHuella3" Content="👍 Dedo 3 (Sin cambios)" Style="{StaticResource FingerprintButton}" Click="btnCapturarDedoEdicion_Click" Tag="3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Botones de Acción -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cancelar" Height="40" Background="#94A3B8" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCancelarEdicion_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="Guardar Cambios" Height="40" Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarEdicion_Click">
