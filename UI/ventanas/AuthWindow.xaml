<Window x:Class="ControlAcceso.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticación Administrador"
        Height="560"
        Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        ResizeMode="NoResize"
        Closing="AuthWindow_Closing">


    <Grid>
        <Border Background="White" CornerRadius="16" Padding="28" Margin="24" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="#000000" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">

                <Border Style="{StaticResource HeaderIcon}">
                    <TextBlock Text="🔐" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Acceso administrativo" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="Ingresa tu contraseña o usa la huella registrada para entrar al panel de administración." FontSize="13" Foreground="#64748B" Margin="0,0,0,24" TextAlignment="Center" TextWrapping="Wrap"/>

                <TextBlock Text="Contraseña" FontSize="13" FontWeight="SemiBold" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16"/>

                <Button x:Name="btnEntrar" Content="Entrar" Height="46" Style="{StaticResource PrimaryButton}" Click="btnEntrar_Click" Margin="0,0,0,12"/>

                <Button x:Name="btnUsarHuella" Content="👆 Usar huella de administrador" Height="46" Style="{StaticResource SecondaryButton}" Click="btnUsarHuella_Click"/>

                <TextBlock x:Name="txtEstado" Text="" FontSize="12" Foreground="#64748B" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
