<Window x:Class="ControlAcceso.AdminAsistenciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Asistencia" Height="450" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Border Background="White" CornerRadius="14" Padding="20" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Registrar asistencia como administrador" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock Text="Agrega una observación opcional para la asistencia de este empleado." FontSize="13" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Empleado seleccionado" FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="txtEmpleadoSeleccionado" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <TextBlock Text="Observación" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                <TextBox x:Name="txtObservacion" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" Background="White"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar" Content="Cancelar" Width="110" Height="38" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Click="btnCancelar_Click"/>
                <Button x:Name="btnAceptar" Content="Registrar" Width="120" Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnAceptar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
